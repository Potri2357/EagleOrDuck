# DSA Sprint Tracker — Environment Configuration
# Copy this to .env and fill in your keys before deploying.
# NEVER commit your real .env file to version control.

# ── Firebase Config ──────────────────────────────────────────
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ── AI API Keys (used by Nakshi — provide at least one) ──────
# Gemini (Google AI Studio): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq (fast LLaMA inference): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Sarvam AI (Indian language models): https://platform.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# ── Notes ─────────────────────────────────────────────────────
# Nakshi uses the above keys in order: Gemini → Groq → Sarvam.
# If no key is set, Nakshi falls back to a built-in empathetic response.
# For deployment, inject these as environment variables in your host
# (Netlify, Vercel, Firebase Hosting, etc.) and reference them
# in the DEPLOYMENT_KEYS block inside index.html.
